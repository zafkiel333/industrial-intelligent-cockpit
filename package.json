{
  "name": "industrial-intelligent-cockpit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-tsx.mjs server.ts",
    "build": "vite build",
    "build:standalone": "vite build --mode standalone",
    "build:microapp": "vite build --mode microapp",
    "build:all": "npm run build:standalone && npm run build:microapp",
    "typecheck": "tsc --noEmit",
    "typecheck:navigation": "tsc -p tsconfig.navigation.json",
    "verify:navigation": "node scripts/run-tsx.mjs scripts/verify-navigation-split.ts",
    "verify:model-library": "node scripts/run-tsx.mjs scripts/verify-model-library-expansion.ts",
    "verify:model-loading": "node scripts/run-tsx.mjs scripts/verify-model-loading-optimization.ts",
    "verify:model-stability": "node scripts/run-tsx.mjs scripts/verify-model-viewer-stability.ts",
    "verify:model-library-live": "node scripts/run-tsx.mjs scripts/verify-live-model-library.ts",
    "audit:model-assets": "node scripts/run-tsx.mjs scripts/audit-upstream-model-assets.ts",
    "verify:https-integration": "node scripts/run-tsx.mjs scripts/verify-https-integration.ts",
    "verify:scene-backgrounds": "node scripts/run-tsx.mjs scripts/verify-scene-backgrounds.ts",
    "verify:simulated-maintenance-backgrounds": "node scripts/run-tsx.mjs scripts/verify-simulated-maintenance-backgrounds.ts",
    "verify:knowledge-management-visuals": "node scripts/run-tsx.mjs scripts/verify-knowledge-management-visuals.ts",
    "verify:maintenance-planning": "node scripts/run-tsx.mjs scripts/verify-maintenance-planning-redesign.ts",
    "verify:life-warning": "node scripts/run-tsx.mjs scripts/verify-life-warning-redesign.ts",
    "verify:cv-images": "node scripts/run-tsx.mjs scripts/verify-cv-monitoring-images.ts",
    "generate:menu-manifest": "node scripts/run-tsx.mjs scripts/generate-scene-library-menu.ts",
    "generate:host-navigation-delivery": "node scripts/run-tsx.mjs scripts/generate-host-navigation-delivery.ts",
    "start": "cross-env NODE_ENV=production node scripts/run-tsx.mjs server.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "docx": "^9.7.1",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.556.0",
    "multer": "^2.1.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-is": "^19.2.4",
    "recharts": "^3.5.1",
    "three": "^0.182.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "d3": "^7.9.0",
    "tsx": "^4.23.11",
    "typescript": "~5.8.2",
    "vite": "^8.0.3"
  }
}
